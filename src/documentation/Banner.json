{
  "paths": {
    "/show": {
      "get": {
        "summary": "Get a specific banner",
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The requested banner",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Banner"
                }
              }
            }
          }
        }
      }
    },
    "/all": {
      "get": {
        "summary": "Get all banners",
        "parameters": [
          {
            "name": "pag",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "orden",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "search",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "A list of all banners",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Banner"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/create": {
      "post": {
        "summary": "Create a new banner",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Banner"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The created banner",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Banner"
                }
              }
            }
          }
        }
      }
    },
    "/update": {
      "post": {
        "summary": "Update an existing banner",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Banner"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The updated banner",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Banner"
                }
              }
            }
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Banner",
      "description": "Banner endpoint"
    }
  ],
  "components": {
    "schemas": {
      "Banner": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "description": "The ID of the banner"
          },
          "name": {
            "type": "string",
            "description": "The name of the banner"
          },
          "image": {
            "type": "string",
            "description": "The image of the banner"
          },
          "orden": {
            "type": "integer",
            "description": "The order of the banner"
          },
          "link": {
            "type": "string",
            "description": "The link of the banner"
          },
          "state": {
            "type": "boolean",
            "description": "The state of the banner"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "description": "The creation date and time of the banner"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "description": "The last update date and time of the banner"
          },
          "deletedAt": {
            "type": "string",
            "format": "date-time",
            "description": "The deletion date and time of the banner"
          }
        },
        "required": [
          "name",
          "image"
        ]
      }
    }
  }
}