{
    "openapi": "3.0.0",
    "info": {
      "title": "Vehicle Additional Services API",
      "version": "1.0.0"
    },
    "paths": {
      "/show": {
        "get": {
          "summary": "Get a specific vehicle additional service",
          "parameters": [
            {
              "name": "id",
              "in": "query",
              "required": true,
              "schema": {
                "type": "integer"
              }
            }
          ],
          "responses": {
            "200": {
              "description": "The requested vehicle additional service",
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/VehicleAdditional"
                  }
                }
              }
            }
          }
        }
      },
      "/all": {
        "get": {
          "summary": "Get all vehicle additional services",
          "parameters": [
            {
              "name": "pag",
              "in": "query",
              "schema": {
                "type": "integer"
              }
            },
            {
              "name": "orden",
              "in": "query",
              "schema": {
                "type": "integer"
              }
            },
            {
              "name": "search",
              "in": "query",
              "schema": {
                "type": "string"
              }
            }
          ],
          "responses": {
            "200": {
              "description": "A list of all vehicle additional services",
              "content": {
                "application/json": {
                  "schema": {
                    "type": "array",
                    "items": {
                      "$ref": "#/components/schemas/VehicleAdditional"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "/create": {
        "post": {
          "summary": "Create a new vehicle additional service",
          "requestBody": {
            "required": true,
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VehicleAdditional"
                }
              }
            }
          },
          "responses": {
            "200": {
              "description": "The created vehicle additional service",
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/VehicleAdditional"
                  }
                }
              }
            }
          }
        }
      },
      "/update": {
        "post": {
          "summary": "Update an existing vehicle additional service",
          "requestBody": {
            "required": true,
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VehicleAdditional"
                }
              }
            }
          },
          "responses": {
            "200": {
              "description": "The updated vehicle additional service",
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/VehicleAdditional"
                  }
                }
              }
            }
          }
        }
      }
    },
    "components": {
      "schemas": {
        "VehicleAdditional": {
          "type": "object",
          "properties": {
            "id": {
              "type": "integer",
              "description": "The ID of the vehicle additional service"
            },
            "name": {
              "type": "string",
              "description": "The name of the vehicle additional service"
            },
            "createdAt": {
              "type": "string",
              "format": "date-time",
              "description": "The creation date and time of the vehicle additional service"
            },
            "updatedAt": {
              "type": "string",
              "format": "date-time",
              "description": "The last update date and time of the vehicle additional service"
            }
          },
          "required": [
            "name"
          ]
        }
      }
    }
  }