{
    "openapi": "3.0.0",
    "info": {
      "title": "Service API",
      "version": "1.0.0"
    },
    "paths": {
      "/show": {
        "get": {
          "summary": "Obtener un servicio específico",
          "parameters": [
            {
              "name": "id",
              "in": "query",
              "required": true,
              "schema": {
                "type": "integer"
              }
            }
          ],
          "responses": {
            "200": {
              "description": "El servicio solicitado",
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/Service"
                  }
                }
              }
            }
          }
        }
      },
      "/all": {
        "get": {
          "summary": "Obtener todos los servicios",
          "parameters": [
            {
              "name": "pag",
              "in": "query",
              "schema": {
                "type": "integer"
              }
            },
            {
              "name": "orden",
              "in": "query",
              "schema": {
                "type": "integer"
              }
            },
            {
              "name": "search",
              "in": "query",
              "schema": {
                "type": "string"
              }
            }
          ],
          "responses": {
            "200": {
              "description": "Una lista de todos los servicios",
              "content": {
                "application/json": {
                  "schema": {
                    "type": "array",
                    "items": {
                      "$ref": "#/components/schemas/Service"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "/create": {
        "post": {
          "summary": "Crear un nuevo servicio",
          "requestBody": {
            "required": true,
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Service"
                }
              }
            }
          },
          "responses": {
            "200": {
              "description": "El servicio creado",
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/Service"
                  }
                }
              }
            }
          }
        }
      },
      "/update": {
        "post": {
          "summary": "Actualizar un servicio existente",
          "requestBody": {
            "required": true,
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Service"
                }
              }
            }
          },
          "responses": {
            "200": {
              "description": "El servicio actualizado",
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/Service"
                  }
                }
              }
            }
          }
        }
      }
    },
    "components": {
      "schemas": {
        "Service": {
          "type": "object",
          "properties": {
            "id": {
              "type": "integer",
              "description": "El ID del servicio"
            },
            "name": {
              "type": "string",
              "description": "El nombre del servicio"
            },
            "image": {
              "type": "string",
              "description": "La imagen del servicio"
            },
            "description": {
              "type": "string",
              "description": "La descripción del servicio"
            },
            "state": {
              "type": "boolean",
              "description": "El estado del servicio"
            },
            "createdAt": {
              "type": "string",
              "format": "date-time",
              "description": "La fecha y hora de creación del servicio"
            },
            "updatedAt": {
              "type": "string",
              "format": "date-time",
              "description": "La última fecha y hora de actualización del servicio"
            },
            "deletedAt": {
              "type": "string",
              "format": "date-time",
              "description": "La fecha y hora de eliminación del servicio"
            }
          },
          "required": [
            "name",
            "image",
            "description"
          ]
        }
      }
    }
  }