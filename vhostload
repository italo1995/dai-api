docRoot                   /home/neuronweb.online/load
vhDomain                  $VH_NAME
vhAliases                 www.$VH_NAME
adminEmails               soporte.neuron@gmail.com
enableGzip                1
enableIpGeo               1

errorlog $VH_ROOT/logs/neuronweb.online.error_log {
  useServer               0
  logLevel                WARN
  rollingSize             10M
}

accesslog $VH_ROOT/logs/neuronweb.online.access_log {
  useServer               0
  logFormat               "%h %l %u %t "%r" %>s %b "%{Referer}i" "%{User-Agent}i""
  logHeaders              5
  rollingSize             10M
  keepDays                10
  compressArchive         1
}

index  {
  useServer               0
  indexFiles              index.php, index.html
}

errorpage 403 {
  url                     403.html
}

errorpage 404 {
  url                     404.html
}

errorpage 500 {
  url                     500.html
}

scripthandler  {
  add                     lsapi:neuro21124336 php
}

phpIniOverride  {
php_admin_value open_basedir "/tmp:$VH_ROOT"
}

extprocessor neuro21124336 {
  type                    lsapi
  address                 UDS://tmp/lshttpd/neuro21124336.sock
  maxConns                10
  env                     LSAPI_CHILDREN=10
  initTimeout             60
  retryTimeout            0
  persistConn             1
  pcKeepAliveTimeout      1
  respBuffer              0
  autoStart               1
  path                    /usr/local/lsws/lsphp74/bin/lsphp
  extUser                 neuro2112
  extGroup                neuro2112
  memSoftLimit            2047M
  memHardLimit            2047M
  procSoftLimit           400
  procHardLimit           500
}

extprocessor apiWebFactory {
  type                    proxy
  address                 127.0.0.1:3003
  maxConns                2000
  pcKeepAliveTimeout      10000
  initTimeout             1
  retryTimeout            1
  respBuffer              0
}

context / {
  type                    proxy
  handler                 apiWebFactory
  addDefaultCharset       off
}

rewrite  {
  enable                  1
  autoLoadHtaccess        1
}

vhssl  {
  keyFile                 /etc/letsencrypt/live/load.neuronweb.online/privkey.pem
  certFile                /etc/letsencrypt/live/load.neuronweb.online/fullchain.pem
  certChain               1
  enableECDHE             1
  renegProtection         1
  sslSessionCache         1
  enableSpdy              15
  enableStapling          1
  ocspRespMaxAge          86400
}

module cache {
storagePath $VH_ROOT/lscache
}