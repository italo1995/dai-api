PORT=6000
# Puerto de Socket.io - separado del HTTP de arriba, mismo proceso (ver src/server.ts)
SOCKET_PORT=6001
DB_USER=postgres
DB_PASSWORD=your_db_password_here
DB_HOST=localhost
DB_NAME=paya
DB_PORT=5432
SQL_DIALECT=postgres
NODE_ENV=development
SECRET_KEY=your_secret_key_here
TWILIO_ACCOUNT_SID=your_twilio_sid_here
TWILIO_AUTH_Token=your_twilio_token_here
TWILIO_PHONE_NUMBER=your_twilio_phone_here
# En false, no se envian SMS reales: el mensaje queda impreso en la terminal
TWILIO_ENABLED=false
# Key server-side para Google Distance Matrix (delivery fee) - sin restriccion de referrer
GOOGLE_MAPS_SERVER_KEY=your_google_maps_server_key_here
