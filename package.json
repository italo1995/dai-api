{
  "name": "paya-api",
  "version": "1.0.1",
  "main": "index.js",
  "scripts": {
    "start": "node build/index.js",
    "dev": "nodemon ./src/index.ts",
    "test": "echo \"Error: no test specified\" && exit 1",
    "clean": "rm -rf ./dist",
    "build": "npm run clean && tsc --build tsconfig.json && sh ./scripts/copy.sh",
    "mi:g": "npx sequelize-cli migration:generate --name",
    "mo:g": "npx sequelize-cli model:generate --name",
    "seed:g": "npx sequelize-cli seed:generate --name",
    "migrate": "npx sequelize-cli db:migrate",
    "seed": "npx sequelize-cli db:seed:all",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write .",
    "check-format": "prettier --check .",
    "CRUD:g": "node ./scripts/generatedModels.js"
  },
